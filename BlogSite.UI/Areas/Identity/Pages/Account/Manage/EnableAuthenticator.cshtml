@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Authenticator Uygulamasını Yapılandır";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<style>
    body {
        background: url('/images/arkaplan.png') no-repeat center center fixed;
        background-size: cover;
        font-family: 'Segoe UI', sans-serif;
        color: #f0f0f0;
    }

    .form-container {
        background-color: rgba(0, 0, 0, 0.75);
        padding: 30px;
        border-radius: 10px;
        color: #fff;
    }

    a {
        color: #9fd4ff;
    }

    kbd {
        background-color: rgba(255, 255, 255, 0.1);
        color: #fff;
        padding: 4px;
        border-radius: 4px;
    }
</style>

<div class="form-container">
    <partial name="_StatusMessage" for="StatusMessage" />

    <h3 class="text-white fw-bold mb-3 text-center">@ViewData["Title"]</h3>

    <div>
        <p>Authenticator uygulamasını yapılandırmak için aşağıdaki adımları izleyin:</p>
        <ol class="list">
            <li>
                <p>
                    İki faktörlü doğrulama uygulaması olarak,
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android için Microsoft Authenticator</a> veya
                    <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS için Microsoft Authenticator</a>, ya da
                    <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android için Google Authenticator</a> ve
                    <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS için Google Authenticator</a> uygulamalarını indirin.
                </p>
            </li>
            <li>
                <p>QR kodunu tarayın ya da aşağıdaki anahtarı authenticator uygulamanıza girin: <kbd>@Model.SharedKey</kbd>. Boşluklar ve büyük/küçük harf önemli değildir.</p>
                <div class="alert alert-info">QR kod oluşturmayı <a href="https://go.microsoft.com/fwlink/?Linkid=852423">öğrenin</a>.</div>
                <div id="qrCode"></div>
                <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
            </li>
            <li>
                <p>
                    QR kodunu taradıktan veya yukarıdaki anahtarı girdikten sonra, uygulamanız benzersiz bir kod sağlayacaktır. Bu kodu aşağıdaki onay kutusuna girin.
                </p>
                <div class="row">
                    <div class="col-md-6">
                        <form id="send-code" method="post">
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Lütfen kodu girin." />
                                <label asp-for="Input.Code" class="control-label form-label">Doğrulama Kodu</label>
                                <span asp-validation-for="Input.Code" class="text-danger"></span>
                            </div>
                            <button type="submit" class="w-100 btn btn-lg btn-primary">Doğrula</button>
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        </form>
                    </div>
                </div>
            </li>
        </ol>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}