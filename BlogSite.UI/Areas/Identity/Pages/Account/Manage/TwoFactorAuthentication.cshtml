@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "İki Adımlı Doğrulama (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<style>
    body {
        background: url('/images/arkaplan.png') no-repeat center center fixed;
        background-size: cover;
        font-family: 'Segoe UI', sans-serif;
        color: #f0f0f0;
    }

    .container-panel {
        background-color: rgba(0, 0, 0, 0.75);
        padding: 30px;
        border-radius: 10px;
        color: #fff;
    }

    .btn {
        margin-bottom: 10px;
    }

    a {
        color: #9fd4ff;
    }
</style>

<div class="container-panel">
    <h2 class="text-white fw-bold mb-3 text-center">@ViewData["Title"]</h2>

    <partial name="_StatusMessage" for="StatusMessage" />

    @{
        var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
        if (consentFeature?.CanTrack ?? true)
        {
            if (Model.Is2faEnabled)
            {
                if (Model.RecoveryCodesLeft == 0)
                {
                    <div class="alert alert-danger">
                        <strong>Hiç kurtarma kodunuz kalmadı.</strong>
                        <p><a asp-page="./GenerateRecoveryCodes">Yeni kurtarma kodları oluşturmalısınız</a>, aksi halde giriş yapamazsınız.</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft == 1)
                {
                    <div class="alert alert-danger">
                        <strong>1 tane kurtarma kodunuz kaldı.</strong>
                        <p><a asp-page="./GenerateRecoveryCodes">Yeni kurtarma kodları oluşturabilirsiniz</a>.</p>
                    </div>
                }
                else if (Model.RecoveryCodesLeft <= 3)
                {
                    <div class="alert alert-warning">
                        <strong>@Model.RecoveryCodesLeft tane kurtarma kodunuz kaldı.</strong>
                        <p><a asp-page="./GenerateRecoveryCodes">Yeni kodlar üretmeniz önerilir</a>.</p>
                    </div>
                }

                if (Model.IsMachineRemembered)
                {
                    <form method="post" style="display: inline-block">
                        <button type="submit" class="btn btn-outline-warning me-2">Bu tarayıcıyı unut</button>
                    </form>
                }

                <a asp-page="./Disable2fa" class="btn btn-outline-danger me-2">2FA'yı Devre Dışı Bırak</a>
                <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-primary">Kurtarma Kodlarını Sıfırla</a>
            }

            <h4 class="mt-4">Authenticator Uygulaması</h4>
            @if (!Model.HasAuthenticator)
            {
                <a asp-page="./EnableAuthenticator" class="btn btn-outline-success">Authenticator Uygulaması Ekle</a>
            }
            else
            {
                <a asp-page="./EnableAuthenticator" class="btn btn-outline-primary me-2">Authenticator'ı Ayarla</a>
                <a asp-page="./ResetAuthenticator" class="btn btn-outline-danger">Authenticator'ı Sıfırla</a>
            }
        }
        else
        {
            <div class="alert alert-danger mt-3">
                <strong>Gizlilik ve çerez politikası kabul edilmedi.</strong>
                <p>İki adımlı doğrulamayı etkinleştirmek için önce bu politikayı kabul etmelisiniz.</p>
            </div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}