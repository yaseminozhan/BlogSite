@page
@model EmailModel
@{
    ViewData["Title"] = "E-posta Yönetimi";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<style>
    body {
        background: url('/images/arkaplan.png') no-repeat center center fixed;
        background-size: cover;
        font-family: 'Segoe UI', sans-serif;
        color: #f0f0f0;
    }

    .form-container {
        background-color: rgba(0, 0, 0, 0.75);
        padding: 30px;
        border-radius: 10px;
        color: #fff;
    }

    label, .form-control::placeholder {
        color: #ccc;
    }

    a {
        color: #9fd4ff;
    }
</style>

<h2 class="text-white fw-bold mb-3 text-center">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="form-container">
            <form id="email-form" method="post">
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>

                @if (Model.IsEmailConfirmed)
                {
                    <div class="form-floating mb-3 input-group">
                        <input asp-for="Email" class="form-control" disabled />
                        <label asp-for="Email" class="form-label">Mevcut E-posta</label>
                        <span class="input-group-text text-success fw-bold">✓</span>
                    </div>
                }
                else
                {
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" disabled />
                        <label asp-for="Email" class="form-label">Mevcut E-posta</label>
                        <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-outline-secondary mt-2">📩 Doğrulama Maili Gönder</button>
                    </div>
                }

                <div class="form-floating mb-3">
                    <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Yeni e-posta adresinizi girin" />
                    <label asp-for="Input.NewEmail" class="form-label">Yeni E-posta</label>
                    <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
                </div>

                <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-lg btn-success">
                    ✉️ E-posta Güncelle
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}