@model List<KonuTakipDurumViewModel>
@{
    ViewData["Title"] = "Konu Listesi";
}

<style>
    body {
        background: url('/images/arkaplan.png') no-repeat center center fixed;
        background-size: cover;
        font-family: 'Segoe UI', sans-serif;
        color: #f8f9fa;
    }

    .konu-kart {
        background-color: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(6px);
        border-left: 4px solid #ffc107;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 15px;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .konu-kart:hover {
        background-color: rgba(255, 255, 255, 0.2);
        transform: scale(1.01);
    }

    h2 {
        color: #ffffff;
        text-shadow: 1px 1px 4px #000;
    }

    .btn {
        font-weight: bold;
        border-radius: 20px;
        padding: 6px 14px;
    }

    .fake-label {
        background-color: #6c757d;
        color: #fff;
        padding: 5px 10px;
        border-radius: 15px;
        font-size: 0.9rem;
        opacity: 0.7;
    }

    .konu-adi {
        font-size: 1.2rem;
        font-weight: 600;
        text-shadow: 0 1px 2px #000;
    }
</style>

<div class="container mt-5">
    <h2 class="fw-bold mb-4 text-center">📚 Konu Listesi</h2>

    @if (Model == null || !Model.Any())
    {
        var sahteKonular = new List<string>
    {
    "Müzik Teorisi",
    "Enstrümanlar",
    "Lo-fi Kültürü",
    "Film Müzikleri",
    "Podcast Yapımı",
    "Analog vs Dijital",
    "Kayıt Teknikleri",
    "HipHop Anlatıları"
    };

        foreach (var fake in sahteKonular)
        {
            <div class="d-flex justify-content-between align-items-center konu-kart">
                <span class="konu-adi">#@fake</span>
            </div>
        }
    }
    else
    {
        @foreach (var konu in Model)
        {
            <div class="d-flex justify-content-between align-items-center konu-kart">
                <span class="konu-adi">#@konu.KonuAdi</span>

                @if (User.Identity.IsAuthenticated)
                {
                    <form asp-action="@(konu.TakipEdiliyor ? "TakibiBirak" : "TakipEt")" method="post" class="m-0">
                        <input type="hidden" name="konuId" value="@konu.KonuId" />
                        <button type="submit" class="btn btn-sm @(konu.TakipEdiliyor ? "btn-danger" : "btn-success")">
                            @(konu.TakipEdiliyor ? "Takibi Bırak" : "Takip Et")
                        </button>
                    </form>
                }
            </div>
        }
    }

    <div class="text-center mt-5">
        <a href="/" class="btn btn-outline-light px-4 py-2" style="border-radius: 30px; font-weight: bold; box-shadow: 0 0 10px rgba(255,255,255,0.2);">
            ⬅️ Anasayfaya Dön
        </a>
    </div>

</div>
